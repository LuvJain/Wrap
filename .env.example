# Application settings
APP_NAME=Payment API
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=True

# Stripe API credentials
# Replace these with your actual Stripe API keys
# For development, use test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key

# Optional: Stripe webhook secret (if you're using webhooks)
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret